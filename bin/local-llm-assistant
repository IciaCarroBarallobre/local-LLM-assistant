#!/usr/bin/env bash

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
PROJECT_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
CLI_NAME="$(basename "$0")"

if [ "$#" -gt 0 ]; then
    set +e
    make -C "$PROJECT_ROOT" -qn "$1" >/dev/null 2>&1
    STATUS=$?
    set -e

    if [ "$STATUS" -eq 2 ]; then
        printf "✗ Unknown command: %s\n\n" "$1"
        printf "Run '%s help' to see available commands.\n" "$CLI_NAME"
        exit 1
    fi
fi

if [ "$#" -eq 0 ]; then
    exec make -C "$PROJECT_ROOT" help
fi

exec make -C "$PROJECT_ROOT" --no-print-directory "$@"