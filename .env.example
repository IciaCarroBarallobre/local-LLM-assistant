# ==========================================================
# Local AI Assistant
# Environment Configuration
# ==========================================================


# ----------------------------------------------------------
# Open WebUI
# ----------------------------------------------------------

# Automatically generated by: make ensure-openwebui-key
WEBUI_SECRET_KEY=
OPENWEBUI_PORT=3000

# -------- Web Search ---------------------------------------
ENABLE_PERSISTENT_CONFIG=false

ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=exa
EXA_API_KEY=

# Maximum context window used by Ollama, in tokens.
# Choose this based on available GPU/CPU memory and the amount of context
# your workload needs. Larger values allow more conversation history,
# tool calls and Web Search results, but increase memory usage.
# Start with 4096 or 8192 and increase only if your workload needs more.
OLLAMA_CONTEXT_LENGTH=8192

# Default model capabilities.
DEFAULT_MODEL_METADATA='{"capabilities":{"web_search":true,"builtin_tools":true},"defaultFeatureIds":["web_search"]}'
DEFAULT_MODEL_PARAMS='{"function_calling":"native","num_ctx":8192}'

# ----------------------------------------------------------
# Ollama
# ----------------------------------------------------------

# Ollama API port.
OLLAMA_PORT=11434

# How long models remain loaded in memory.
# Examples: 0, 5m, 1h, 24h
OLLAMA_KEEP_ALIVE=24h


# ----------------------------------------------------------
# Ollama Resources
# ----------------------------------------------------------

# Optional resource limits for the Ollama Docker container.
#
# Leave empty for automatic detection:
#   CPU    → 100% of available physical cores
#   Memory → 70% of available system RAM
#
# Examples:
#   OLLAMA_CPUS=8
#   OLLAMA_MEMORY=4g

OLLAMA_CPUS=
OLLAMA_MEMORY=


# ----------------------------------------------------------
# Ollama Models
# ----------------------------------------------------------

# Models downloaded automatically by "make setup".
# Separate multiple models with spaces.

OLLAMA_MODELS="qwen3:8b"
